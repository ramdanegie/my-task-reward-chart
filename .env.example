# MySQL connection string
# Format: mysql://user:password@host:port/database
DATABASE_URL="mysql://user:password@localhost:3306/mtrc"
# Public URL of the deployed app — Auth.js uses this to construct callback URLs.
# Required when the server is behind a reverse proxy (nginx, DomaiNesia, etc.).
AUTH_URL=""
# Generate with: npx auth secret
AUTH_SECRET=""
CHILD_SESSION_SECRET=""
# Optional — Google OAuth (email/password works without these):
# Get credentials at https://console.cloud.google.com
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
