# Local dev: relative path resolves to prisma/dev.db
# Production (standalone server): use an ABSOLUTE path so migrate + runtime agree,
#   e.g. DATABASE_URL="file:/home/USER/repositories/my-task-reward-chart/prisma/dev.db"
DATABASE_URL="file:./dev.db"
# Generate with: npx auth secret
AUTH_SECRET=""
CHILD_SESSION_SECRET=""
# Optional — Google OAuth (email/password works without these):
# Get credentials at https://console.cloud.google.com
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
